# Copy this file to .env.foe, fill in the two secrets, then run:
#   chmod 600 .env.foe
#
# The sync command reads this file directly; do not `source` it in a shell.
FOE_USERNAME=
FOE_PASSWORD=
FOE_WORLD=us24

# Optional tuning. Defaults are normally sufficient.
# FOE_MARKET=us
# FOE_CONTRIBUTION_LOOKBACK_DAYS=3
# FOE_LOG_PAGE_SIZE=100
# FOE_REQUEST_DELAY_SECONDS=0.10
# FOE_H=
# Safety assertions only: if set, these must match the live ForgeHX bundle.
# FOE_CLIENT_VERSION=auto
# FOE_SIGNATURE_SECRET=

# Browser-backed Forge Hammer treasury export. These defaults use the Chrome
# installation, profile data, and Downloads directory detected for the current
# macOS user. Set overrides in .env.foe only when those defaults do not apply.
# FOE_CHROME_PROFILE_DIRECTORY=Profile 3
# For scheduled runs, prefer an isolated data directory and its Default profile:
# FOE_CHROME_USER_DATA_DIR=~/.foe-automation-chrome
# FOE_CHROME_PROFILE_DIRECTORY=Default
# FOE_FORGE_HAMMER_TIMEOUT_SECONDS=600
