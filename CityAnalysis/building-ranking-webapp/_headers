/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/src/*
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=31536000, immutable

/data/ranking-core.json.br
  Content-Encoding: br
  Content-Type: application/json; charset=utf-8

/data/ages/*.json.br
  Content-Encoding: br
  Content-Type: application/json; charset=utf-8

/data/city-ages/*.json.br
  Content-Encoding: br
  Content-Type: application/json; charset=utf-8

/data/ranking-core.json.gz
  Content-Encoding: gzip
  Content-Type: application/json; charset=utf-8

/data/ages/*.json.gz
  Content-Encoding: gzip
  Content-Type: application/json; charset=utf-8

/data/city-ages/*.json.gz
  Content-Encoding: gzip
  Content-Type: application/json; charset=utf-8

/favicon.png
  Cache-Control: public, max-age=31536000, immutable
